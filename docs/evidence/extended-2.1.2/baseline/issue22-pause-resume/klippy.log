	INNER_DISCARD_FILAMENT_BASE_DISCARD
	MOVE_TO_XY_IDLE_POSITION_EXTRUDER
	RESTORE_GCODE_STATE NAME=auto_clean_t2

[gcode_macro _EXTRUDER_OFFSET_ACTION_AUTO_CLEAN_T3]
gcode = 
	{% set filament_soft = params.SOFT | default(0) | int %}
	{% set nozzle_diameter = params.NOZZLE_DIAMETER | default(0.4) | float %}
	
	T3 A0
	SAVE_GCODE_STATE NAME=auto_clean_t3
	MOVE_TO_DISCARD_FILAMENT_POSITION
	G90
	M204 S10000
	M83
	{% if nozzle_diameter < 0.3 %}
	{% if filament_soft == 0 %}
	G1 E30 F210
	G1 E-20 F360
	{% else %}
	G1 E5 F60
	G1 E-10 F360
	{% endif %}
	{% else %}
	{% if filament_soft == 0 %}
	G1 E30 F600
	G1 E-20 F1200
	{% else %}
	G1 E5 F120
	G1 E-10 F600
	{% endif %}
	{% endif %}
	INNER_CUTOFF_BASE_DISCARD
	INNER_ROUGHLY_CLEAN_NOZZLE_BASE_DISCARD ACTION=4
	INNER_DISCARD_FILAMENT_BASE_DISCARD
	MOVE_TO_XY_IDLE_POSITION_EXTRUDER
	RESTORE_GCODE_STATE NAME=auto_clean_t3

