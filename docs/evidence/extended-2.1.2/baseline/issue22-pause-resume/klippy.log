	G0 X1.25 Y-0.5
	G0 X-1.5 Y1.5
	G0 X-0.5 Y-1
	G0 X1 Y-0.5
	G0 X-1.5 Y1.5
	G0 X-0.5 Y-1
	G0 X1 Y-0.5
	G0 X-1.5 Y1.5
	G0 X-0.5 Y-1
	G0 X1 Y-0.5
	G0 X-1.5 Y1.5
	G0 X-0.5 Y-1
	G0 Y-0.8
	G0 X6

[gcode_macro FINELY_CLEAN_NOZZLE_STAGE_2]
