[gcode_macro SM_PRINT_CHECK_SWITCH_EXTRUDER]
gcode = 
	SET_ACTION_CODE ACTION=PRINT_SWITCH_CHECKING
	{% for i in range(printer.configfile.settings.printer.max_physical_extruder_num) %}
	{% if printer.print_task_config['extruders_used'][i] %}
	T{i} A0
	{% endif %}
	{% endfor %}
	SET_ACTION_CODE ACTION=IDLE

[gcode_macro SM_PRINT_EXTRUDER_PREHEAT]
gcode = 
	{% set extruder = params.EXTRUDER | default(999) | int %}
	{% set temp = params.TEMP | default(140) | int %}
	{% if extruder >= 0 and
	extruder < printer.configfile.settings.printer.max_physical_extruder_num
	and printer.print_task_config['extruders_used'][extruder] %}
	M104 S{temp} T{extruder} A0
	{% endif %}

[gcode_macro SM_PRINT_AUTO_FEED]
gcode = 
	{% set filament_feed_vars = printer['gcode_macro _FILAMENT_FEED_VARIABLE'] | default({}) %}
	{% set extruder = params.EXTRUDER | default(999) | int %}
	{% if filament_feed_vars != {} and
	extruder >= 0 and
	extruder < printer.configfile.settings.printer.max_physical_extruder_num %}
	{% if printer.print_task_config['extruders_used'][extruder] %}
	{% set feed_module_seq = filament_feed_vars.module_sequence[extruder] %}
	{% set feed_channel_seq = filament_feed_vars.channel_sequence[extruder] %}
	FEED_AUTO MODULE={feed_module_seq} CHANNEL={feed_channel_seq} LOAD=1 PRINTING=1 {rawparams}
	{% endif %}
	{% else %}
	{% if filament_feed_vars == {} %}
	RESPOND TYPE=error MSG='{"gcode_macro _FILAMENT_FEED_VARIABLE error!"}'
	{% else %}
	RESPOND TYPE=error MSG='{"extruder error: %d!" % (extruder)}'
	{% endif %}
	{% endif %}

[gcode_macro SM_PRINT_END_AUTO_UNLOAD_FILAMENT]
gcode = 
	{% for i in range(printer.configfile.settings.printer.max_physical_extruder_num) %}
	{% if printer.print_task_config['extruders_used'][i] and
	printer.print_task_config['filament_soft'][i] == False and
	printer.print_task_config['end_unload_filament'][i] == True %}
	AUTO_FEEDING EXTRUDER={i} UNLOAD=1 STAGE=prepare
	AUTO_FEEDING EXTRUDER={i} UNLOAD=1 STAGE=doing
	{% endif %}
	{% endfor %}

[gcode_macro SM_PRINT_START_LINE]
gcode = 
	{% set index = params.INDEX | default(999) | int %}
	{% set target_temp = params.TARGET_TEMP | default(0) | int %}
	
	{% if index >= 0 and index < 8 and target_temp != 0 %}
	G90
	G0 Z3 F5000
	{% if printer.print_task_config['extruder_map_table'][index] == 0 %}
	SM_PRINT_START_LINE_EXTRUDER_0 {rawparams}
	{% elif printer.print_task_config['extruder_map_table'][index] == 1 %}
	SM_PRINT_START_LINE_EXTRUDER_1 {rawparams}
	{% elif printer.print_task_config['extruder_map_table'][index] == 2 %}
	SM_PRINT_START_LINE_EXTRUDER_2 {rawparams}
	{% elif printer.print_task_config['extruder_map_table'][index] == 3 %}
	SM_PRINT_START_LINE_EXTRUDER_3 {rawparams}
	{% endif %}
	{% endif %}

[gcode_macro SM_PRINT_START_LINE_EXTRUDER_0]
variable_has_finished = False
gcode = 
	{% set target_temp = params.TARGET_TEMP | default(250) | int %}
	
	{% if has_finished == False %}
	T0 A0
	G90
	G0 X10 Y3 Z2 F18000
	M109 S{target_temp}
	G1 Z0.2
	G91
	M83
	G1 X40 E15 F360
	G0 E-0.5
	G90
	G1 Z3
	SET_GCODE_VARIABLE MACRO=SM_PRINT_START_LINE_EXTRUDER_0 VARIABLE=has_finished VALUE=True
	{% endif %}

[gcode_macro SM_PRINT_START_LINE_EXTRUDER_1]
variable_has_finished = False
gcode = 
	{% set target_temp = params.TARGET_TEMP | default(250) | int %}
	
	{% if has_finished == False %}
	T1 A0
	G90
	G0 X60 Y3 Z2 F18000
	M109 S{target_temp}
	G1 Z0.2
	G91
	M83
	G1 X40 E15 F360
	G0 E-0.5
	G90
	G1 Z3
	SET_GCODE_VARIABLE MACRO=SM_PRINT_START_LINE_EXTRUDER_1 VARIABLE=has_finished VALUE=True
	{% endif %}

[gcode_macro SM_PRINT_START_LINE_EXTRUDER_2]
variable_has_finished = False
gcode = 
	{% set target_temp = params.TARGET_TEMP | default(250) | int %}
	
	{% if has_finished == False %}
	T2 A0
	G90
	G0 X110 Y3 Z2 F18000
	M109 S{target_temp}
	G1 Z0.2
	G91
	M83
	G1 X40 E15 F360
	G0 E-0.5
	G90
	G1 Z3
