[gcode_macro INNER_ROUGHLY_CLEAN_NOZZLE_BASE_DISCARD]
gcode = 
	{% set accel = params.ACCEL | default(10000) | int %}
	{% set speed = params.SPEED | default(10000) | int %}
	{% set action = params.ACTION | default(4) | int %}
	
	G91
	M204 S{accel}
	G1 F{speed}
	
	{% if printer.toolhead.extruder == 'extruder' %}
	G1 Y10
	{% if action == 1 %}
	G1 X-1 Y15
	G1 X-4 Y-10
	G1 X5 Y-5
	{% elif action == 2 %}
	G1 X-5 Y10
	G1 X1 Y5
	G1 X4 Y-15
	{% elif action == 3 %}
	G1 X-1 Y15
	G1 X-2 Y-15
	G1 X-2 Y15
	G1 X5 Y-15
	{% else %}
	G1 X-1 Y15
	G1 Y-15
	G1 X-1 Y15
	G1 Y-15
	G1 X-1 Y15
	G1 Y-15
	G1 X-1 Y15
	G1 X-1 Y-8
	G1 X5 Y-7
	{% endif %}
	G1 Y-10
	{% else %}
	G1 Y10
	{% if action == 1 %}
	G1 X1 Y15
	G1 X4 Y-10
	G1 X-5 Y-5
	{% elif action == 2 %}
	G1 X5 Y10
	G1 X-1 Y5
	G1 X-4 Y-15
	{% elif action == 3 %}
	G1 X1 Y15
	G1 X2 Y-15
	G1 X2 Y15
	G1 X-5 Y-15
	{% else %}
	G1 X1 Y15
	G1 Y-15
	G1 X1 Y15
	G1 Y-15
	G1 X1 Y15
	G1 Y-15
	G1 X1 Y15
	G1 X1 Y-8
	G1 X-5 Y-7
	{% endif %}
	G1 Y-10
	{% endif %}

[gcode_macro INNER_DISCARD_FILAMENT_BASE_DISCARD]
variable_random_pos = 1
gcode = 
	{% set accel = params.ACCEL | default(10000) | int %}
	{% set speed = params.SPEED | default(5000) | int %}
	{% set random_position = random_pos % 6 %}
	{% set discard_position = 5.5 + random_position * 0.5 %}
	G91
	M204 S{accel}
	G1 F{speed}
	G1 Y-{discard_position}
	{% if printer.toolhead.extruder == 'extruder' %}
	G1 X-10
	G1 X10
	G1 X-10
	G1 X10
	{% else %}
	G1 X10
	G1 X-10
	G1 X10
	G1 X-10
	{% endif %}
	G1 Y{discard_position}
	SET_GCODE_VARIABLE MACRO=INNER_DISCARD_FILAMENT_BASE_DISCARD VARIABLE=random_pos VALUE={random_pos + 1}

[gcode_macro INNER_CUTOFF_BASE_DISCARD]
gcode = 
	{% set accel = params.ACCEL | default(10000) | int %}
	{% set speed = params.SPEED | default(5000) | int %}
	
	G91
	M204 S{accel}
	G1 F{speed}
	G1 Y-1
	{% if printer.toolhead.extruder == 'extruder' %}
	G1 X-9.5
	G1 X9.5
	G1 X-9.5
	G1 X9.5
	G1 X-9.5
	G1 X9.5
	{% else %}
	G1 X9.5
	G1 X-9.5
	G1 X9.5
	G1 X-9.5
	G1 X9.5
	G1 X-9.5
	{% endif %}
	G1 Y1

[gcode_macro INNER_FLUSH_FILAMENT]
gcode = 
	{% set nozzle_diameter = params.NOZZLE_DIAMETER | default(0.4) | float %}
	{% set soft = params.SOFT | default(0) | int %}
	{% set temp = params.TEMP | default(250) | int %}
	{% set speed_default = 360 if soft == 0 else 200 %}
	{% if nozzle_diameter < 0.3 %}
	{% set speed_default = 210 if soft == 0 else 60 %}
	{% endif %}
	{% set speed = params.SPEED | default(speed_default) | int %}
	{% set length = params.LENGTH | default(80.0) | float %}
	{% set retract_length_default = 5.0 if soft == 0 else 2.0 %}
	{% set retract_length = params.RETRACT_LENGTH | default(retract_length_default) | float %}
	{% set e_pos = printer[printer.toolhead.extruder].printing_e_pos | float | abs %}
	{% if printer['print_stats'].state == 'paused' or printer['print_stats'].state == 'printing' %}
	{% set retract_length = e_pos %}
	{% endif %}
	
	M106 S255
	G4 P5000
	INNER_CUTOFF_BASE_DISCARD
	INNER_ROUGHLY_CLEAN_NOZZLE_BASE_DISCARD ACTION=1
	INNER_DISCARD_FILAMENT_BASE_DISCARD
	M107
	M400
	M109 S{temp}
	M83
	G1 E{length} F{speed}
	M400
	M104 S0
	M106 S255
	_CLIENT_RETRACT LENGTH={retract_length}
	M400
	G4 P5000
	INNER_CUTOFF_BASE_DISCARD
	INNER_ROUGHLY_CLEAN_NOZZLE_BASE_DISCARD ACTION=2
	INNER_DISCARD_FILAMENT_BASE_DISCARD
	M107

[gcode_macro INNER_MANUAL_FEED_STAGE_PREPARE]
gcode = 
	{% set is_paused = True if printer['print_stats'].state == 'paused' else False %}
	{% if is_paused == False %}
	SET_IDLE_TIMEOUT TIMEOUT={printer.configfile.settings.idle_timeout.timeout_on_pause}
	{% endif %}
	MOVE_TO_DISCARD_FILAMENT_POSITION
	INNER_CUTOFF_BASE_DISCARD
	INNER_DISCARD_FILAMENT_BASE_DISCARD

[gcode_macro INNER_MANUAL_FEED_STAGE_EXTRUDE]
gcode = 
	{% set nozzle_diameter = params.NOZZLE_DIAMETER | default(0.4) | float %}
	{% set soft = params.SOFT | default(0) | int %}
	{% set temp = params.TEMP | default(250) | int %}
	{% set speed_default = 360 if soft == 0 else 200 %}
	{% if nozzle_diameter < 0.3 %}
	{% set speed_default = 210 if soft == 0 else 60 %}
	{% endif %}
	{% set speed = params.SPEED | default(speed_default) | int %}
	M109 S{temp}
	M83
	G1 E70 F{speed}

[gcode_macro INNER_MANUAL_FEED_STAGE_FLUSH]
gcode = 
	INNER_FLUSH_FILAMENT {rawparams}

[gcode_macro INNER_MANUAL_FEED_STAGE_FINISH]
gcode = 
	{% set is_paused = True if printer['print_stats'].state == 'paused' else False %}
	M104 S0
	M107
	{% if is_paused == False %}
	SET_IDLE_TIMEOUT TIMEOUT={printer.configfile.settings.idle_timeout.timeout}
	{% endif %}

[gcode_macro INNER_MANUAL_FEED_STAGE_CANCEL]
gcode = 
	{% set is_paused = True if printer['print_stats'].state == 'paused' else False %}
	M104 S0
	M106 S255
	G4 P5000
	INNER_CUTOFF_BASE_DISCARD
	INNER_ROUGHLY_CLEAN_NOZZLE_BASE_DISCARD ACTION=3
	INNER_DISCARD_FILAMENT_BASE_DISCARD
	M107
	{% if is_paused == False %}
	SET_IDLE_TIMEOUT TIMEOUT={printer.configfile.settings.idle_timeout.timeout}
	{% endif %}

[gcode_macro INNER_FLOW_MEASURE_END_BASE_DISCARD]
gcode = 
	G4
	M106 S255
	
	M104 S170
	G4 P3000
	M107
	
	INNER_CUTOFF_BASE_DISCARD
	INNER_ROUGHLY_CLEAN_NOZZLE_BASE_DISCARD ACTION=1
	INNER_DISCARD_FILAMENT_BASE_DISCARD

[gcode_macro INNER_FLOW_CALIB_END_BASE_DISCARD]
gcode = 
	M106 S255
	
	M109 S170
	M107
	
	M104 S0
	INNER_CUTOFF_BASE_DISCARD
	INNER_ROUGHLY_CLEAN_NOZZLE_BASE_DISCARD ACTION=3
	INNER_DISCARD_FILAMENT_BASE_DISCARD

[gcode_macro INNER_PREEXTRUDE_FILAMENT]
gcode = 
	{% set temp = params.TEMP | default(220) | int %}
	{% set speed = params.SPEED | default(360) | float %}
	{% set length = params.LENGTH | default(20) | float %}
	{% set retract_length = params.RETRACT_LENGTH | default(0.5) | abs %}
	{% set filament_soft = params.SOFT | default(False) %}
	{% if filament_soft == True %}
	{% set speed = 120 %}
	{% set length = 10 %}
	{% endif %}
	SAVE_GCODE_STATE NAME=preextrude
	SET_ACTION_CODE ACTION=PRINT_PREEXTRUDING
	MOVE_TO_DISCARD_FILAMENT_POSITION
	M204 S10000
	M109 S{temp}
	M83
	INNER_APPLY_FLOW_K EXTRUDER={printer.toolhead.extruder} APPLY=1
	G1 E{length} F{speed}
	INNER_APPLY_FLOW_K EXTRUDER={printer.toolhead.extruder} APPLY=0
	G1 E-{retract_length}
	M400
	M106 S255
	G4 P5000
	M400
	INNER_CUTOFF_BASE_DISCARD
